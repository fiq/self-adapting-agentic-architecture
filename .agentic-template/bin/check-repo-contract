    (
        "agents-review-consolidation-controls",
        "AGENTS.md",
        "Independent review and consolidation",
        [
            "Reviews are read-only",
            "share no mutable state",
            "findings combine additively",
            "conclusions may still contradict",
            "Read-only is an invariant to enforce, not a fact to assume",
            "Implementation agents must not share a file",
            "different briefs",
            "aim each brief at a region the previous passes did not examine",
            "deduplicate overlapping findings",
            "adjudicate contradictions rather than averaging them",
            "verify every finding against the code",
            "apply the resulting fixes serially",
            "A single clean review is not strong evidence",
            "Passing checks are not a review",
            "Do not merge on green CI alone",
            "do not treat a reviewer's confidence as evidence",
        ],
    ),
    (
        "agents-mutation-evidence-controls",
        "AGENTS.md",
        "Testing expectations",
        # Prose presence only. This checks the rule is written down; nothing here can
        # observe that a mutation was run. See CHG-020, which records that limit.
        [
            "Prove that an assertion can fail",
            "restore the file unchanged, and record what was broken",
            "tells you nothing until you have seen it fail",
            "This is scoped, not universal",
            "may be replaced by an alternative",
            "does not show the oracle is right",
            "Reading does not catch these",
        ],
    ),
    (
        "agents-rebase-timing-controls",
        "AGENTS.md",
        "Rebase timing",
        [
            "as soon as anything else merges, not when you come to merge it",
            "is the guaranteed conflict surface",
            "Rebase before recording anything that references state from",
            "force-with-lease",
            "never on",
        ],
    ),
    (
        "agents-template-required-sections",
        ".agentic-template/templates/AGENTS_TEMPLATE.md",
        "Required sections",
        [
            "Independent review and consolidation",
