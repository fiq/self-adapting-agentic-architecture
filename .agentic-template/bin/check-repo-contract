            "conclusions may still contradict",
            "Read-only is an invariant to enforce, not a fact to assume",
            "Implementation agents must not share a file",
            "adjudicate contradictions rather than averaging them",
            "apply fixes serially",
            "passing checks are not a review",
        ],
    ),
]

# Credential-shaped strings that must never enter a commit message. Scoped to
# commits on this branch and not on the integration branch, so the check governs
# new work rather than failing on history that predates it.
COMMIT_MESSAGE_FORBIDDEN = [
    (r"claude\.ai/code/session_[A-Za-z0-9]+", "a Claude session URL"),
    (r"session_[A-Za-z0-9]{20,}", "a session identifier"),
    (r"sk-[A-Za-z0-9_-]{20,}", "an API key"),
    (r"gh[pousr]_[A-Za-z0-9]{20,}", "a GitHub token"),
    (r"(?i)authorization:\s*bearer\s+\S+", "a bearer credential"),
]

def check_commit_messages(errors):
    import subprocess
    try:
        base = subprocess.run(
            ["git", "merge-base", "HEAD", "origin/main"],
            cwd=ROOT, capture_output=True, text=True, timeout=30)
        if base.returncode != 0:
            return
        log = subprocess.run(
            ["git", "log", f"{base.stdout.strip()}..HEAD", "--format=%H%x00%B%x00"],
            cwd=ROOT, capture_output=True, text=True, timeout=30)
        if log.returncode != 0:
            return
    except Exception:
        # Never let an unavailable git turn into a silent pass claim.
        errors.append("check_commit_messages could not inspect git history")
        return
    entries = [e for e in log.stdout.split("\x00") if e.strip()]
    for i in range(0, len(entries) - 1, 2):
        sha, body = entries[i].strip()[:9], entries[i + 1]
        for pattern, label in COMMIT_MESSAGE_FORBIDDEN:
            if re.search(pattern, body):
                errors.append(
                    f"commit {sha} message contains {label}; a public commit message "
                    "cannot be redacted after the fact"
                )

def check_review_consolidation_contract(errors):
    for test_id, relative, section, phrases in REVIEW_CONSOLIDATION_CONTROLS:
        path = ROOT / relative
        if not path.exists():
            # REQUIRED_FILES fails on an absent AGENTS.md; the template is checked here.
            errors.append(f"missing {relative}, required by {test_id}")
            continue
        sections = split_markdown_sections(path.read_text())
        if section not in sections:
            errors.append(f"{relative} is missing section '## {section}', required by {test_id}")
            continue
        compact = compact_whitespace(sections[section])
        missing = [p for p in phrases if compact_whitespace(p) not in compact]
        if missing:
            errors.append(
                f"{relative} section '## {section}' is missing controls required by "
                f"{test_id}: " + "; ".join(missing)
            )

def check_model_routing_policy(errors):
    path = ROOT / ".agents/coordination/MODEL_ROUTING_POLICY.md"
    if not path.exists():
        # REQUIRED_FILES already fails on absence; returning here would otherwise
        # let a deleted policy pass this check vacuously.
        return
    sections = split_markdown_sections(path.read_text())
    for test_id, section, phrases in MODEL_ROUTING_POLICY_CONTROLS:
        if section not in sections:
            errors.append(
                ".agents/coordination/MODEL_ROUTING_POLICY.md is missing section "
                f"'## {section}' required by {test_id}"
            )
            continue
        compact = compact_whitespace(sections[section])
        missing = [phrase for phrase in phrases if compact_whitespace(phrase) not in compact]
        if missing:
            errors.append(
                ".agents/coordination/MODEL_ROUTING_POLICY.md section "
                f"'## {section}' is missing controls required by {test_id}: "
                + "; ".join(missing)
            )

def main():
    errors = []
    for rel in REQUIRED_FILES:
        if not (ROOT / rel).exists():
            errors.append(f"missing {rel}")
    for rel in REQUIRED_EXECUTABLES:
        path = ROOT / rel
        if path.exists() and not os.access(path, os.X_OK):
            errors.append(f"{rel} is not executable")
    claude = ROOT / "CLAUDE.md"
    if not claude.is_symlink():
        errors.append("CLAUDE.md is not a symlink")
    elif os.readlink(claude) != "AGENTS.md":
        errors.append("CLAUDE.md does not link to AGENTS.md")
    check_session_startup(ROOT / "AGENTS.md", "AGENTS.md", errors)
    check_session_startup(
        ROOT / ".agentic-template/templates/AGENTS_TEMPLATE.md",
        "AGENTS template",
        errors,
    )
    check_required_text(
        ROOT / ".github/copilot-instructions.md",
        ".github/copilot-instructions.md",
        "read `AGENTS.md` from disk",
        "{label} must instruct agents to read AGENTS.md from disk",
        errors,
    )
    check_required_text(
        ROOT / ".github/copilot-instructions.md",
        ".github/copilot-instructions.md",
        ".agentic-template/bin/project startup",
        "{label} must point agents to .agentic-template/bin/project startup",
        errors,
    )
    check_required_text(
        ROOT / ".cursor/rules/agentic-startup-and-skills.mdc",
        ".cursor/rules/agentic-startup-and-skills.mdc",
        "read `AGENTS.md` from disk",
        "{label} must instruct agents to read AGENTS.md from disk",
        errors,
    )
    check_required_text(
        ROOT / ".cursor/rules/agentic-startup-and-skills.mdc",
        ".cursor/rules/agentic-startup-and-skills.mdc",
        ".agents/skills/CATALOG.toon",
        "{label} must point agents to .agents/skills/CATALOG.toon",
        errors,
    )
    check_required_text(
        ROOT / ".claude/skills/agentic-template/SKILL.md",
        ".claude/skills/agentic-template/SKILL.md",
        "read `../AGENTS.md` from disk",
        "{label} must instruct agents to read ../AGENTS.md from disk",
        errors,
    )
    check_required_text(
        ROOT / ".claude/skills/agentic-template/SKILL.md",
        ".claude/skills/agentic-template/SKILL.md",
        ".agents/skills/CATALOG.toon",
        "{label} must point agents to .agents/skills/CATALOG.toon",
        errors,
    )
    for rel in [".codex/README.md", ".claude/README.md"]:
        check_required_text(
            ROOT / rel,
            rel,
            "read `../AGENTS.md` from disk",
            "{label} must instruct agents to read ../AGENTS.md from disk",
            errors,
        )
        check_required_text(
            ROOT / rel,
            rel,
            ".agentic-template/bin/project startup",
            "{label} must point agents to .agentic-template/bin/project startup",
            errors,
        )
    for required in ["AGENTIC TEAM STARTUP", "WHAT HAPPENS NEXT", "START PATHS", "OPTIONS"]:
        check_required_text(
            ROOT / ".agentic-template/bin/startup",
            ".agentic-template/bin/startup",
            required,
            "{label} must print startup welcome, sequence and options",
            errors,
        )
    for required in ["START PATHS", "Start Here", "Current State", "Delivery Workflow"]:
        check_required_text(
            ROOT / ".agentic-template/bin/docs-map",
            ".agentic-template/bin/docs-map",
            required,
            "{label} must present a route-based documentation IA",
            errors,
        )
    check_required_text(
        ROOT / ".agentic-template/bin/docs-map",
        ".agentic-template/bin/docs-map",
        "Context Store",
        "{label} must include the Context Store route",
        errors,
    )
    check_context_store(errors)
    check_model_routing_policy(errors)
    check_review_consolidation_contract(errors)
    check_commit_messages(errors)
    for skill in REQUIRED_SKILLS:
        skill_path = ROOT / ".agents/skills" / skill / "SKILL.md"
        if not skill_path.exists():
            errors.append(f"missing skill {skill}")
    for skill_path in sorted((ROOT / ".agents/skills").rglob("SKILL.md")):
        problem = check_skill_frontmatter(skill_path)
        if problem:
            errors.append(f"{skill_path.relative_to(ROOT)} {problem}")
    for skill_path in sorted((ROOT / ".claude/skills").rglob("SKILL.md")):
        problem = check_skill_frontmatter(skill_path)
        if problem:
            errors.append(f"{skill_path.relative_to(ROOT)} {problem}")
    project_script = ROOT / ".agentic-template/bin/project"
    if project_script.exists():
        result = subprocess.run(
            [str(project_script), "--list"],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
        )
        if result.returncode:
            errors.append(".agentic-template/bin/project --list failed")
        else:
            commands = set(result.stdout.splitlines())
            for command in PROJECT_COMMANDS:
                if command not in commands:
                    errors.append(f".agentic-template/bin/project missing command {command}")
    if errors:
        return fail(errors)
    print("REPO CONTRACT OK")
    return 0

if __name__ == "__main__":
    sys.exit(main())
