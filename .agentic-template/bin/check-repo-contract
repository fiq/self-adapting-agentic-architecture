def split_markdown_sections(text):
    """Map each `## ` heading to its body, so a control is checked where it belongs."""
    sections = {}
    heading = None
    body = []
    for line in text.splitlines():
        if line.startswith("## "):
            if heading is not None:
                sections[heading] = "\n".join(body)
            heading = line[3:].strip()
            body = []
        elif heading is not None:
            body.append(line)
    if heading is not None:
        sections[heading] = "\n".join(body)
    return sections

# One entry per CHG-015 scenario, so each acceptance mapping has a check that names
# it on failure, matching the MODEL_ROUTING_POLICY_CONTROLS shape above.
