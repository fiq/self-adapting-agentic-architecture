    "specialise/runtime-elixir",
    "specialise/runtime-godot",
    "specialise/messaging-kafka",
    "specialise/sql-migrations",
    "specialise/test-harness",
    "specialise/container-build",
    "specialise/infra-local-compose",
    "specialise/infra-decision",
    "specialise/ci",
    "workflow/test-first",
    "workflow/reassess-project-profile",
    "workflow/handoff-maintenance",
    "workflow/reconcile-delivery",
    "coordination/team-selection",
    "coordination/sudo",
    "coordination/adversarial-debate",
    "coordination/agent-team-fallback",
    "coordination/worktree-status",
    "coordination/backlog-status",
    "knowledge/knowledge-search",
    "knowledge/knowledge-capture",
    "tooling/detect-mcp",
    "tooling/detect-superpowers",
    "tooling/context-packet",
    "tooling/model-routing",
]

PROJECT_COMMANDS = [
    "help", "startup", "init", "inspect", "check", "backlog", "test",
    "contract-test", "integration-test", "component-test", "e2e-test",
    "lint", "run", "image", "image-test", "repo-check", "check-profile",
    "check-handoff", "check-knowledge", "check-tooling", "check-mcp",
    "check-readme", "ready", "compose-config", "compose-test", "infra-check",
    "docs", "doctor", "self-test", "worktree-status",
]

def fail(lines):
    print("REPO CONTRACT FAILED")
    print()
    for line in lines:
        print("- " + line)
    return 1

def check_skill_frontmatter(path):
    text = path.read_text()
    if not text.startswith("---\n"):
        return "missing frontmatter"
    end = text.find("\n---", 4)
    if end < 0:
        return "unterminated frontmatter"
    frontmatter = text[4:end]
    if "\nname:" not in "\n" + frontmatter:
        return "frontmatter missing name"
    if "\ndescription:" not in "\n" + frontmatter:
        return "frontmatter missing description"
    return None

def compact_whitespace(text):
    return " ".join(text.split())

def check_required_text(path, label, required_text, error, errors):
    if not path.exists():
        return
    compact = compact_whitespace(path.read_text())
    if required_text not in compact:
        errors.append(error.format(label=label))

def check_session_startup(path, label, errors):
    if not path.exists():
        return
    text = path.read_text()
    heading = "## Session startup"
    read_rule = "read `AGENTS.md` from disk"
    if heading not in text:
        errors.append(f"{label} missing {heading}")
        return
    section_start = text.find(heading)
    next_heading = text.find("\n## ", section_start + len(heading))
    if next_heading < 0:
        section = text[section_start:]
    else:
        section = text[section_start:next_heading]
    compact = compact_whitespace(section)
    if read_rule not in compact:
        errors.append(f"{label} must instruct agents to read AGENTS.md from disk")
    project_identity = text.find("## Project identity")
    if project_identity >= 0 and section_start > project_identity:
        errors.append(f"{label} {heading} must appear before ## Project identity")

def check_context_store(errors):
    path = ROOT / "docs/context-store.md"
    if not path.exists():
        return
    compact = compact_whitespace(path.read_text())
    required = [
        "Structure",
        "Lineage",
        "Behavior",
        "Conformance",
        "Do not add an external vector store, database or SaaS memory layer by default",
    ]
    if any(item not in compact for item in required):
        errors.append(
            "docs/context-store.md must describe repo-native context store "
            "layers and default external-store posture"
        )

def main():
    errors = []
    for rel in REQUIRED_FILES:
        if not (ROOT / rel).exists():
            errors.append(f"missing {rel}")
    for rel in REQUIRED_EXECUTABLES:
        path = ROOT / rel
        if path.exists() and not os.access(path, os.X_OK):
            errors.append(f"{rel} is not executable")
    claude = ROOT / "CLAUDE.md"
    if not claude.is_symlink():
        errors.append("CLAUDE.md is not a symlink")
    elif os.readlink(claude) != "AGENTS.md":
        errors.append("CLAUDE.md does not link to AGENTS.md")
    check_session_startup(ROOT / "AGENTS.md", "AGENTS.md", errors)
    check_session_startup(
        ROOT / ".agentic-template/templates/AGENTS_TEMPLATE.md",
        "AGENTS template",
        errors,
    )
    check_required_text(
        ROOT / ".github/copilot-instructions.md",
        ".github/copilot-instructions.md",
        "read `AGENTS.md` from disk",
        "{label} must instruct agents to read AGENTS.md from disk",
        errors,
    )
    check_required_text(
        ROOT / ".github/copilot-instructions.md",
        ".github/copilot-instructions.md",
        ".agentic-template/bin/project startup",
        "{label} must point agents to .agentic-template/bin/project startup",
        errors,
    )
    check_required_text(
        ROOT / ".cursor/rules/agentic-startup-and-skills.mdc",
        ".cursor/rules/agentic-startup-and-skills.mdc",
        "read `AGENTS.md` from disk",
        "{label} must instruct agents to read AGENTS.md from disk",
        errors,
    )
    check_required_text(
        ROOT / ".cursor/rules/agentic-startup-and-skills.mdc",
        ".cursor/rules/agentic-startup-and-skills.mdc",
        ".agents/skills/CATALOG.toon",
        "{label} must point agents to .agents/skills/CATALOG.toon",
        errors,
    )
    check_required_text(
        ROOT / ".claude/skills/agentic-template/SKILL.md",
        ".claude/skills/agentic-template/SKILL.md",
        "read `../AGENTS.md` from disk",
        "{label} must instruct agents to read ../AGENTS.md from disk",
        errors,
    )
    check_required_text(
        ROOT / ".claude/skills/agentic-template/SKILL.md",
        ".claude/skills/agentic-template/SKILL.md",
        ".agents/skills/CATALOG.toon",
        "{label} must point agents to .agents/skills/CATALOG.toon",
        errors,
    )
    for rel in [".codex/README.md", ".claude/README.md"]:
        check_required_text(
            ROOT / rel,
            rel,
            "read `../AGENTS.md` from disk",
            "{label} must instruct agents to read ../AGENTS.md from disk",
            errors,
        )
        check_required_text(
            ROOT / rel,
            rel,
            ".agentic-template/bin/project startup",
            "{label} must point agents to .agentic-template/bin/project startup",
            errors,
        )
    for required in ["AGENTIC TEAM STARTUP", "WHAT HAPPENS NEXT", "START PATHS", "OPTIONS"]:
        check_required_text(
            ROOT / ".agentic-template/bin/startup",
            ".agentic-template/bin/startup",
            required,
            "{label} must print startup welcome, sequence and options",
            errors,
        )
    for required in ["START PATHS", "Start Here", "Current State", "Delivery Workflow"]:
        check_required_text(
            ROOT / ".agentic-template/bin/docs-map",
            ".agentic-template/bin/docs-map",
            required,
            "{label} must present a route-based documentation IA",
            errors,
        )
    check_required_text(
        ROOT / ".agentic-template/bin/docs-map",
        ".agentic-template/bin/docs-map",
        "Context Store",
        "{label} must include the Context Store route",
        errors,
    )
    check_context_store(errors)
    for skill in REQUIRED_SKILLS:
        skill_path = ROOT / ".agents/skills" / skill / "SKILL.md"
        if not skill_path.exists():
            errors.append(f"missing skill {skill}")
    for skill_path in sorted((ROOT / ".agents/skills").rglob("SKILL.md")):
        problem = check_skill_frontmatter(skill_path)
        if problem:
            errors.append(f"{skill_path.relative_to(ROOT)} {problem}")
    for skill_path in sorted((ROOT / ".claude/skills").rglob("SKILL.md")):
        problem = check_skill_frontmatter(skill_path)
        if problem:
            errors.append(f"{skill_path.relative_to(ROOT)} {problem}")
    project_script = ROOT / ".agentic-template/bin/project"
    if project_script.exists():
        result = subprocess.run(
            [str(project_script), "--list"],
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
        )
        if result.returncode:
            errors.append(".agentic-template/bin/project --list failed")
        else:
            commands = set(result.stdout.splitlines())
            for command in PROJECT_COMMANDS:
                if command not in commands:
                    errors.append(f".agentic-template/bin/project missing command {command}")
    if errors:
        return fail(errors)
    print("REPO CONTRACT OK")
    return 0

if __name__ == "__main__":
    sys.exit(main())
