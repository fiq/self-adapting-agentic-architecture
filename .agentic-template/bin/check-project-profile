#!/usr/bin/env python3
from pathlib import Path
import re
import sys

ROOT = Path.cwd()
PROFILE = ROOT / "PROJECT_PROFILE.toon"
CUSTOM = ROOT / "CUSTOMIZE_THIS_PROJECT.toon"

REQUIRED_SECTIONS = [
    "project:",
    "audience:",
    "facts:",
    "inferences:",
    "decisions:",
    "unknowns:",
    "rejected_options:",
    "architecture:",
    "testing:",
    "structured_data:",
    "containers:",
    "infrastructure:",
    "tooling:",
]

UNKNOWN_FIELDS = [
    "id:",
    "question:",
    "why_it_matters:",
    "evidence:",
    "working_assumption:",
    "consequence_if_wrong:",
    "blocking:",
    "validation:",
    "status:",
]

def fail(msg):
    print("ERROR")
    print()
    print(msg)
    return 1

def section_block(text, section):
    start = text.find(section)
    if start < 0:
        return ""
    next_positions = [text.find("\n" + s, start + 1) for s in REQUIRED_SECTIONS if text.find("\n" + s, start + 1) > 0]
    end = min(next_positions) if next_positions else len(text)
    return text[start:end]

def nested_format(block, key):
    pattern = rf"(?m)^  {re.escape(key)}:\n(?:    .*\n)*?    format: ([a-z_]+)"
    match = re.search(pattern, block)
    return match.group(1) if match else None

def validate_structured_data(text, label):
    block = section_block(text, "structured_data:")
    if not block:
        return f"{label} structured_data section is missing"
    control_format = nested_format(block, "control_files")
    if control_format is not None and control_format != "toon":
        return f"{label} structured_data.control_files.format must be toon"
    state_format = nested_format(block, "state_and_contracts")
    if state_format not in {"toon", "s_expression"}:
        return (
            f"{label} structured_data.state_and_contracts.format must be "
            "toon or s_expression"
        )
    rules_format = nested_format(block, "rules_and_compute")
    if rules_format not in {"toon", "s_expression", "none"}:
        return (
            f"{label} structured_data.rules_and_compute.format must be "
            "toon, s_expression or none"
        )
    return None

def validate_context_budget(text, label):
    tooling = section_block(text, "tooling:")
    if "context_budget:" not in tooling:
        return f"{label} tooling.context_budget section is missing"
    target = re.search(r"(?m)^    default_target: ([a-z_]+)", tooling)
    if not target or target.group(1) not in {"small", "medium", "large"}:
        return f"{label} tooling.context_budget.default_target must be small, medium or large"
    reserve = re.search(r"(?m)^    reserve_response_percent: ([0-9]+)", tooling)
    if not reserve:
        return f"{label} tooling.context_budget.reserve_response_percent is missing"
    percent = int(reserve.group(1))
    if percent < 20 or percent > 60:
        return f"{label} tooling.context_budget.reserve_response_percent must be between 20 and 60"
    if "opaque_transport_blobs: false" not in tooling:
        return f"{label} tooling.context_budget.opaque_transport_blobs must be false"
    return None

def main():
    if not PROFILE.exists():
        return fail("PROJECT_PROFILE.toon missing")
    text = PROFILE.read_text()
    missing = [s for s in REQUIRED_SECTIONS if s not in text]
    if missing:
        return fail("PROJECT_PROFILE.toon missing sections: " + ", ".join(missing))
    structured_error = validate_structured_data(text, "PROJECT_PROFILE.toon")
    if structured_error:
        return fail(structured_error)
    context_error = validate_context_budget(text, "PROJECT_PROFILE.toon")
    if context_error:
        return fail(context_error)

    unknowns = section_block(text, "unknowns:")
    if "\n  - id:" in unknowns:
        blocks = unknowns.split("\n  - id:")[1:]
        for block in blocks:
            candidate = "id:" + block
            missing_fields = [f for f in UNKNOWN_FIELDS if f not in candidate]
            if missing_fields:
                return fail("Malformed unknown is missing fields: " + ", ".join(missing_fields))

    if CUSTOM.exists():
        custom = CUSTOM.read_text()
        if "structured_data:" in custom:
            custom_error = validate_structured_data(custom, "CUSTOMIZE_THIS_PROJECT.toon")
            if custom_error:
                return fail(custom_error)
        if "context_budget:" in custom:
            custom_context_error = validate_context_budget(custom, "CUSTOMIZE_THIS_PROJECT.toon")
            if custom_context_error:
                return fail(custom_context_error)
        customised = (
            "status: customised" in custom
            or "status: customized" in custom
            or "status: consumed" in custom
        )
        if customised:
            unresolved = []
            for marker in [
                "application_shape: unknown",
                "language: unknown",
                "framework: unknown",
                "build_system: unknown",
                "harness: unspecialised",
                "application_image: unknown",
            ]:
                if marker in text:
                    unresolved.append(marker)
            if unresolved:
                return fail(
                    "Project marked customised while required specialisation is unresolved: "
                    + ", ".join(unresolved)
                )

    # Audience calibration must exist. Template state may leave it unresolved,
    # but a specialised project must record skill level, app shape and an
    # explicit, bought-into right-sizing decision.
    audience_block = section_block(text, "audience:")
    for field in ["skill_level:", "app_shape:", "right_sizing:"]:
        if field not in audience_block:
            return fail("PROJECT_PROFILE.toon audience section is missing " + field)
    if "state: template" not in text:
        for marker in ["skill_level: unknown", "app_shape: unknown"]:
            if marker in audience_block:
                return fail(
                    "Specialised project has unresolved audience calibration: " + marker
                )
        if "bought_in: false" in audience_block:
            return fail(
                "Specialised project has no bought-into right-sizing decision "
                "(audience.right_sizing.bought_in is false)"
            )

    # Template state is allowed to have unresolved decisions, but the
    # infrastructure section must exist so the decision is explicit after
    # specialisation.
    if "state: template" not in text:
        infra_block = section_block(text, "infrastructure:")
        if "iac:" not in infra_block:
            return fail(
                "PROJECT_PROFILE.toon infrastructure section is missing iac decision"
            )
        if "local_topology:" not in infra_block:
            return fail(
                "PROJECT_PROFILE.toon infrastructure section is missing local_topology"
            )
        if "deployment_target:" not in infra_block:
            return fail(
                "PROJECT_PROFILE.toon infrastructure section is missing deployment_target"
            )

    print("PROJECT PROFILE OK")
    return 0

if __name__ == "__main__":
    sys.exit(main())
