#!/usr/bin/env python3
import sys


def main():
    command = sys.argv[1] if len(sys.argv) > 1 else "command"
    reason = sys.argv[2] if len(sys.argv) > 2 else "No project reason supplied."
    print("NOT APPLICABLE")
    print()
    print(f"{command}: {reason}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
