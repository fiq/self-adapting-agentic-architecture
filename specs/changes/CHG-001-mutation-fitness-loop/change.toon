change:
  id: CHG-001
  title: Mutation fitness loop
  status: accepted
  intent: Prove one model-proposed workflow mutation can be validated, isolated, evaluated and deterministically promoted or discarded.
  audience_level: developer
  relates_to:
    - DOM-001
    - SYS-001
    - ARCH-001
    - RISK-001
    - Q-001
    - Q-002
    - Q-003

deltas:
  - op: ADDED
    capability: mutation-fitness-loop
    requirement: The system evaluates a bounded workflow mutation candidate without allowing the model to approve its own result.
    scenarios:
      - id: S1
        when: a baseline workflow is available and the model proposes a valid bounded mutation
        then: the system creates and commits a candidate in an isolated Git worktree
        and:
          - candidate work does not modify the coordination checkout
      - id: S2
        when: deterministic checks and benchmarks complete for the candidate
        then: the system records EvaluationEvidence and calculates a multi-objective FitnessResult
        and:
          - scoring uses deterministic evidence rather than model approval
      - id: S3
        when: the FitnessResult does not satisfy promotion policy
        then: the candidate is discarded deterministically
        and:
          - rollback or cleanup remains outside model authority
      - id: S4
        when: the model proposes an invalid, unsupported or authority-bearing mutation
        then: deterministic validation rejects the proposal before candidate creation or evaluation
        and:
          - model-provided approval, scoring, promotion or rollback authority is not exposed in the mutation proposal contract

acceptance:
  - scenario: S1
    test_id: adapters/LangChain4jMutationProposalAdapterTest.mapsTypedAiServiceProposalToCoreMutation
    layer: unit
  - scenario: S1
    test_id: adapters/LangChain4jMutationProposalAdapterTest.createsTypedAiServiceFromChatModelWithoutCommittingToProvider
    layer: unit
  - scenario: S1
    test_id: deterministic/MutationEvaluationLoopAcceptanceTest.evaluatesOneCandidateAndDiscardsWhenFitnessFailsThreshold
    layer: component
  - scenario: S1
    test_id: adapters/GitCandidateWorkspaceIntegrationTest.createsCommittedCandidateInIsolatedWorktreeWithoutTouchingCoordinationCheckout
    layer: component-integration
  - scenario: S2
    test_id: deterministic/MutationEvaluationLoopAcceptanceTest.evaluatesOneCandidateAndDiscardsWhenFitnessFailsThreshold
    layer: component
  - scenario: S2
    test_id: adapters/SqliteExperimentMetadataStoreIntegrationTest.recordsCandidateFitnessAndEvaluationEvidence
    layer: component-integration
  - scenario: S2
    test_id: adapters/CommandCheckRunnerIntegrationTest.runsConfiguredCommandsInCandidateWorktreeAndRecordsExitStatus
    layer: component-integration
  - scenario: S2
    test_id: benchmarks/JmhBenchmarkRunnerIntegrationTest.convertsJmhPrimaryResultToBenchmarkEvidence
    layer: component-integration
  - scenario: S3
    test_id: deterministic/MutationEvaluationLoopAcceptanceTest.evaluatesOneCandidateAndDiscardsWhenFitnessFailsThreshold
    layer: component
  - scenario: S4
    test_id: adapters/LangChain4jMutationProposalAdapterTest.rejectsModelOutputOutsideTheBoundedMutationContract
    layer: unit
  - scenario: S4
    test_id: adapters/LangChain4jMutationProposalAdapterTest.rejectsMalformedModelOutputDeterministically
    layer: unit
  - scenario: S4
    test_id: adapters/LangChain4jMutationProposalAdapterTest.rejectsOversizedModelOutputDeterministically
    layer: unit
  - scenario: S4
    test_id: deterministic/BoundedMutationValidatorTest.rejectsOversizedMutationFields
    layer: unit
  - scenario: S4
    test_id: deterministic/BoundedMutationValidatorTest.rejectsAuthorityBearingMutationText
    layer: unit
  - scenario: S4
    test_id: adapters/LangChain4jMutationProposalAdapterTest.mutationProposalContractDoesNotExposeApprovalOrScoringAuthority
    layer: unit
  - scenario: S4
    test_id: deterministic/MutationEvaluationLoopAcceptanceTest.stopsInvalidModelProposalBeforeCandidateCreationAndEvaluation
    layer: component
  - scenario: S4
    test_id: deterministic/MutationEvaluationLoopAcceptanceTest.realValidatorStopsAuthorityBearingProposalBeforeCandidateCreationAndEvaluation
    layer: component

tasks:
  - id: T1
    slice: define plain Java records and application ports for the loop
    status: completed
  - id: T2
    slice: make the outside-in component test fail for missing loop implementation
    status: completed
  - id: T3
    slice: implement the deterministic orchestration with fake adapters
    status: completed
  - id: T4
    slice: add real Git worktree and SQLite integration tests after approval
    status: completed
  - id: T5
    slice: implement deterministic command check and JMH benchmark evidence adapters
    status: completed
  - id: T6
    slice: implement provider-neutral LangChain4j typed-service mutation proposal adapter
    status: completed
  - id: T7
    slice: implement deterministic bounded mutation validator policy
    status: completed
  - id: T8
    slice: select first live LangChain4j provider and CLI configuration path
    status: pending

non_goals:
  - OpenSearch or vector storage
  - AST mutation
  - LSP integration
  - distributed workers
  - automatic production deployment

risks:
  - RISK-001 model self-approval if deterministic boundaries are weakened
