    layer: unit
  - scenario: S3
    test_id: deterministic/GenerationEvaluationLoopTest.theSameMutationIdOverTheSamePatchFailsNamingNonVariation
    layer: unit
  - scenario: S3
    test_id: cli/EvolveCommandAcceptanceTest.aLiveGenerationWhoseProposerRepeatsIdAndPatchFailsNamingNonVariation
