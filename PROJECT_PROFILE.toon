project:
  state: live_loop_policy_proposed
  name: self-adapting-agentic-architecture
  confidence: medium
  concept_date: 2026-07-25
  concept_date_reason: user requested project initialization as a Java-first experimental platform

audience:
  skill_level: developer
  app_shape: cli
  language_by_role:
    - role: core_domain
      language: Java
    - role: cli
      language: Java with picocli
    - role: model_adapter
      language: Java with LangChain4j behind deterministic ports
    - role: persistence
      language: Java with SQLite adapter
    - role: benchmarks
      language: Java with JMH
  right_sizing:
    smallest_sufficient: local Gradle Java CLI evaluating one Git-worktree candidate at a time through plain Java ports and deterministic policies
    deliberately_excluded:
      - OpenSearch, generic vector platforms and production retrieval infrastructure; the earlier blanket vector deferral is now intentionally revisited only by the bounded local Neo4j experiment in ADR-0004
      - AST mutation because bounded behavior-first mutation contracts can be realized through ordinary Git diffs before AST infrastructure is justified
      - LSP integration because repair diagnostics can start from deterministic validation output
      - distributed workers because local sequential evaluation is sufficient until benchmark throughput becomes a measured bottleneck
      - automatic production deployment because promotion policy and rollback must be proven manually first
    revisit_when:
      - experiment evidence requires semantic search across workflow or evaluation history
      - targeted mutation contracts and Git diff realization cause repeated safety or correctness failures
      - repairs repeatedly need language-server diagnostics
      - local benchmark throughput blocks research cadence
      - users request unattended promotion into protected integration branches or production
    bought_in: true

facts:
  - id: user_requested_java_platform
    observation: user requested Java, Gradle, LangChain4j, picocli, SQLite, JUnit 5, AssertJ, jqwik, JMH and Git worktrees
    evidence:
      - CUSTOMIZE_THIS_PROJECT.toon
      - user prompt 2026-07-25
    confidence: high
  - id: no_prior_application_runtime
    observation: repository inspection before customization found no application runtime evidence
    evidence:
      - .agentic-template/bin/project init output
      - .agentic-template/bin/inspect-project
    confidence: high

inferences:
  - id: cli_first_experimental_shape
    conclusion: the smallest useful product shape is a local CLI rather than a service
    based_on:
      - user requested picocli
      - candidate isolation depends on local Git worktrees
      - automatic production deployment is explicitly deferred
    confidence: high
    validation: first CLI slice exercises one mutation evaluation end to end
  - id: plain_java_core_boundary
    conclusion: the domain layer should contain only records, deterministic value checks and policies with no LangChain4j or infrastructure imports
    based_on:
      - user required LangChain4j behind adapters
      - deterministic approval boundary is central to safety
    confidence: high
    validation: .agentic-template/bin/project lint

decisions:
  - id: langchain4j_adapter_boundary
    decision: LangChain4j is allowed only in the adapters/langchain4j package of modules/adapters and reached through deterministic ports
    reason:
      - keeps the domain layer plain Java
      - prevents model-provider details from controlling validation, scoring or promotion
    confidence: high
    status: active
    validation:
      - .agentic-template/bin/project lint
      - docs/architecture/module-boundaries.md
    consequence_if_changed: model-provider code could leak into deterministic decision paths
  - id: deterministic_approval_boundary
    decision: model output may propose or repair mutations but may not approve candidates
    reason:
      - approval must be auditable and repeatable
      - fitness scores and promotion decisions must remain deterministic
    confidence: high
    status: active
    validation:
      - specs/capabilities/CAP-001-mutation-fitness-loop.toon
      - modules/deterministic/src/acceptanceTest/java/com/dreamthought/saaa/deterministic/MutationEvaluationLoopAcceptanceTest.java
    consequence_if_changed: experiments could self-reinforce model-preferred candidates without independent fitness evidence
  - id: sqlite_experiment_metadata
    decision: persist experiment metadata in SQLite through an adapter
    reason:
      - local experiments need durable audit state
      - SQLite keeps operational complexity low
      - no server database evidence exists yet
    confidence: medium
    status: active
    validation:
      - .agentic-template/bin/project integration-test
    consequence_if_changed: experiment lineage may need a heavier operational dependency
  - id: git_worktree_candidate_isolation
    decision: create mutation candidates in isolated Git worktrees and commit candidate state before evaluation
    reason:
      - isolates candidate changes from coordination checkout
      - gives every evaluation auditable Git provenance
    confidence: high
    status: active
    validation:
      - .agentic-template/bin/project integration-test
    consequence_if_changed: candidate evaluation could mutate shared working state
  - id: no_application_container_initially
    decision: do not build a container image for the first local CLI slice
    reason:
      - there is no deployable service or web app
      - Nix and Gradle are sufficient for local execution
    confidence: medium
    status: active
    validation:
      - README.md
      - .agentic-template/bin/project ready
    consequence_if_changed: distribution work could distract from validating the mutation loop
  - id: bounded_local_hybrid_graphrag_experiment
    decision: intentionally revisit the earlier vector/container deferral with an on-demand bounded Neo4j Community projection, provider-neutral embeddings, versioned Evidence Capsules, a disposable retrieval SQLite projection and Git-rehydratable evolutionary memory
    reason:
      - the recorded semantic-search revisit trigger has been reached by an explicit owner experiment
      - structural, semantic and prior evaluation evidence must be compared under NONE, VECTOR, GRAPH and HYBRID treatments
      - Neo4j remains rebuildable from repository artifacts and observable outcomes rather than becoming canonical storage
      - compact Git experiment envelopes preserve observable outcomes while a generated wiki page remains a non-authoritative human projection
      - lineage-novelty-v1 bounds the hot graph by evolutionary value rather than age and supports explicit historic reinflation
      - one graph relates partitioned subject and SAAA process repository revisions through explicit evolution contexts
      - JGit is the zero-setup primary API for read-only Git access, with native Git as a visible compatibility fallback and for linked candidate worktrees
      - retrieval biases search while deterministic fitness remains the sole survival authority
      - the Neo4j Community UBI10 manifest is digest-pinned, HTTP-disabled and loopback-only; RISK-005 tracks Java findings pending an upstream patched image
    confidence: medium
    status: experimental
    validation:
      - docs/decisions/0004-local-hybrid-graphrag-experiment.md
      - specs/changes/CHG-005-local-hybrid-graphrag/
      - .agentic-template/bin/project graphrag-integration-test
      - .agentic-template/bin/project component-test
    consequence_if_changed: remove or simplify the projection only after the ablation evidence and owner review are recorded; do not erase the original deferral history
  - id: staged_ci_validation_profiles
    decision: pull-request CI runs the fast feedback profile with repository checks, README checks, unit tests, component tests, integration tests and architecture lint, while pushes to `main`, `v*` tags and manual full dispatch run that profile plus full readiness
    reason:
      - duplicate push/pull_request workflows and the redundant repo-contract workflow spent most of the avoidable GitHub Actions time
      - fast PR feedback should prove repository contracts, specs, architecture boundaries, unit behavior and the ATDD/integration evidence that is load-bearing for workflow-loop changes
      - full validation still needs `project ready` for repository-wide readiness checks, but the full path is strongest when it also runs the fast checks that `ready` does not include
    confidence: medium
    status: active
    validation:
      - .github/workflows/ci.yml
      - .agentic-template/bin/project check
    consequence_if_changed: CI may either become slow and quota-heavy again or let behaviour-level evidence fall out of the automatic PR gate
  - id: jqwik_1_9_3_pending_policy_review
    decision: pin jqwik to 1.9.3 for the initial scaffold
    reason:
      - user requested jqwik property tests
      - jqwik 1.10.x release notes include explicit anti-AI-agent usage language
      - this repository is AI-agent-assisted
    confidence: medium
    status: active
    validation:
      - gradle/libs.versions.toml
      - future dependency policy review
    consequence_if_changed: using jqwik 1.10.x may conflict with the project's AI-assisted workflow
  - id: tool_unavailable_integration_fallback
    decision: allow PR-less actor-reviewed integration only when PR tooling is unavailable and the user explicitly authorizes shipping to main
    reason:
      - GitHub app and gh PR creation were unavailable for this repository
      - direct main integration still needs branch isolation, deterministic checks, completed risk-appropriate actor review when available or explicit human review when substituted after actor timeout, lead self-review and explicit provenance
    confidence: high
    status: active
    precondition_currently_false: PR creation works as of 2026-07-31, so the fallback does not apply; CHG-003 was integrated through PR #1 with human review as the merge gate. The policy stays active because the precondition can recur, but an agent must verify PR tooling is genuinely unavailable before invoking it rather than assuming the earlier failure still holds.
    validation:
      - AGENTS.md
      - docs/wiki/development.md
      - .agents/knowledge/patterns/PAT-001-tool-unavailable-integration-fallback.md
    consequence_if_changed: future agents may either block unnecessarily on unavailable PR tooling or push to main without adequate actor-review or substituted human-review evidence
  - id: live_loop_policy_proposal
    decision: propose OpenAI via LangChain4j official adapter, TOON mutation-contract envelopes, S-expression internal mutation IR, a closed mutation operator enum with hill-climb and exploratory-leap search posture operators, Git diff realization, conceptual crossover deferral, local promoted candidate refs and deterministic hard-gated phenotype fitness objectives for the next implementation slice
    reason:
      - resolves the remaining high-impact loop questions before live model execution
      - treats the evolutionary process as loop engineering with semi-declarative operator input into the next loop
      - keeps provider-specific code, review tooling and promotion side effects outside deterministic core decisions
      - uses repo-native contracts and Git evidence instead of adding new infrastructure
    confidence: medium
    status: proposed
    validation:
      - specs/changes/CHG-002-live-loop-policy/
      - .agentic-template/bin/project check-changes
    consequence_if_changed: the next live loop slice should revise CHG-002 before implementation rather than embedding policy assumptions in code
  - id: invariant_named_module_layout
    decision: group all Java under `modules/`, merge the four adapter modules into one, and name layers `domain`, `deterministic`, `adapters`, `cli` and `benchmarks` after what each may know
    reason:
      - the repository root mixed five code directories with docs, specs, nix and gradle scaffolding, which obscured which directories were layers
      - four adapter modules held eight files between them; adapter-versus-adapter isolation was pre-abstraction while `deterministic <- adapters` is the boundary that carries weight
      - `deterministic` states the project's central invariant in the folder name, so "no provider code here" reads as obvious rather than arbitrary
      - package base moved to `com.dreamthought.saaa` at the same time, so one mechanical sweep covered both
    confidence: medium
    status: active
    validation:
      - .agentic-template/bin/project lint
      - docs/architecture/module-boundaries.md
      - modules/domain/build.gradle.kts declares no dependencies, so the inward rule is a compile error
    consequence_if_changed: collapsing further into a single module would put provider libraries on the same classpath as scoring policy and reduce the LangChain4j boundary to a text search, which model-authored candidate code could satisfy while still reaching the provider
  - id: three_layer_vision_with_vertical_slices
    decision: SAAA is designed as three concentric layers (workflow evolution, tool surface for a custom agentic loop, product-code generalisation) and delivered through vertical slices across all three layers wherever possible, with population and conceptual crossover as foundation slices that upgrade every layer at once
    reason:
      - a stated direction stops the README from either overclaiming or underclaiming and gives the next slices a place to land
      - vertical slices test the outer-loop tool vocabulary and the Layer-3 safety story on real use, rather than designing them in isolation
      - foundation slices for population and crossover apply to every target, so pulling them out of vertical slices avoids re-deriving the mechanic per layer
      - the deterministic decision boundary in ARCH-001 continues to hold at every layer; the model may propose or repair, never approve
    confidence: medium
    status: active
    validation:
      - docs/decisions/0002-three-layer-vision.md
      - .agents/knowledge/decisions/ADR-0002-three-layer-vision.md
      - README.md
      - PR #3 (https://github.com/fiq/self-adapting-agentic-architecutre/pull/3) merged 2026-07-31 as 4a9ea7f after human review
    consequence_if_changed: the population, crossover and Layer-3 slices need re-planning against a different delivery pattern before scope widens further
  - id: smart_bridge_northbound_interfaces
    decision: SAAA should expose MCP for tool-aware agents and a narrow OpenAI-compatible API for existing clients that want SAAA as a governed smart bridge in front of multiple models and external agents
    reason:
      - MCP gives outer agents explicit typed tools for operations such as evolve, score and inspect-candidate
      - OpenAI-compatible clients, gateways and eval harnesses can adopt SAAA by changing base URL and model name
      - Claude, OpenAI, local models and specialist external agents should remain southbound adapter choices rather than deterministic-layer dependencies
      - the product story is a governed model bridge / agentic control plane rather than another standalone model
    confidence: medium
    status: proposed
    validation:
      - docs/decisions/0003-smart-bridge-northbound-interfaces.md
      - .agents/knowledge/decisions/ADR-0003-smart-bridge-northbound-interfaces.md
      - .agentic-template/bin/project check
    consequence_if_changed: the L2 interface plan and any future northbound OpenAI-compatible facade need replanning before implementation
  - id: harness_agnostic_southbound_execution
    decision: SAAA owns a provider-neutral AgentHarness boundary; Goose, OpenCode, Codex, Claude, local processes and direct model APIs remain swappable adapters
    reason:
      - a harness is an execution engine, not the authority that validates or promotes a candidate
      - one neutral contract permits comparable experiments across agent products and providers
      - route, resource budget, workspace isolation and structured evidence belong to SAAA's control plane
      - transport and vendor details such as ACP, MCP, CLI and provider SDKs should not leak into domain or deterministic code
    confidence: medium
    status: active
    validation:
      - specs/changes/CHG-006-agent-harness-boundary/change.toon
      - modules/deterministic/src/main/java/com/dreamthought/saaa/deterministic/AgentHarness.java
      - docs/wiki/architecture.md
    consequence_if_changed: choosing a single agent product as the architecture would require replanning the southbound adapter boundary and cross-harness experiment strategy

unknowns:
  - id: Q-001
    question: Which model provider and LangChain4j integration should be used first?
    why_it_matters:
      - affects adapter configuration and test doubles
      - affects retrieval and tool-calling support
    evidence:
      - user specified LangChain4j but not a provider
    working_assumption: CHG-002 proposes OpenAI through LangChain4j's official OpenAI adapter, with provider and model selected by explicit CLI configuration
    consequence_if_wrong: the provider factory can be replaced inside the adapters/langchain4j package without changing domain or deterministic ports
    blocking: false
    validation:
      - modules/adapters/src/test/java/com/dreamthought/saaa/adapters/langchain4j/LangChain4jMutationProposalAdapterTest.java
      - specs/changes/CHG-002-live-loop-policy/
    status: open
  - id: Q-002
    question: What is the first behavior-first mutation contract and internal representation format?
    why_it_matters:
      - determines validation semantics
      - determines how targeted behavioral intent, loci, bounds and evidence are validated before implementation
    evidence:
      - user requested plain Java records for WorkflowGraph and Mutation
    working_assumption: CHG-002 proposes TOON mutation-contract envelopes with canonical S-expression internal mutation IR; the realized candidate is recorded as a Git diff and commit
    consequence_if_wrong: the envelope or IR format can be tightened without redefining mutation as edit mechanics
    blocking: false
    validation:
      - specs/changes/CHG-002-live-loop-policy/
    status: open
  - id: Q-003
    question: What branch or namespace should promoted candidates target?
    why_it_matters:
      - promotion can mean a local branch, a candidate registry update or a protected integration branch
      - rollback semantics depend on the target
    evidence:
      - user requested promoted or discarded but did not specify target branch policy
    working_assumption: CHG-002 proposes local `refs/heads/promoted/<candidate-id>` plus SQLite promotion metadata, not main or production
    consequence_if_wrong: promotion can retarget a protected integration branch later without changing candidate creation semantics
    blocking: false
    validation:
      - specs/changes/CHG-002-live-loop-policy/
    status: open
  - id: Q-004
    question: What initial objectives and weights should define multi-objective fitness?
    why_it_matters:
      - score thresholds determine promotion and discard behavior
      - benchmark evidence can dominate correctness if weights are wrong
    evidence:
      - user requested deterministic checks, benchmarks and multi-objective scoring
    working_assumption: CHG-002 proposes validation, checks and required phenotype evaluation evidence as hard gates, with task success, reliability, cost and latency budgets, behavioral safety and parsimony as weighted objectives
    consequence_if_wrong: objective weights can change without permitting model-authored approval, weakening deterministic gates or optimizing for edit mechanics instead of behavior
    blocking: false
    validation:
      - specs/changes/CHG-002-live-loop-policy/
    status: open
  - id: Q-005
    question: What first crossover policy captures diversity of thought without unauditable diff recombination?
    why_it_matters:
      - crossover can combine useful techniques from evaluated candidates
      - raw LLM-authored diff merging would amplify nondeterminism and weaken auditability
    evidence:
      - user requested thinking about conceptual or technique crossover
      - docs/architecture/evolutionary-operators.md
    working_assumption: start with conceptual trait recombination over evidence-backed parents, producing a new targeted mutation contract with one primary locus
    consequence_if_wrong: useful cross-candidate lessons may be lost or crossover may become too broad to validate
    blocking: false
    validation:
      - specs/changes/CHG-002-live-loop-policy/
      - docs/architecture/evolutionary-operators.md
    status: open
  - id: Q-006
    question: What search posture policy should balance local hill climbing against bounded exploratory leaps?
    why_it_matters:
      - hill climbing can exploit promising parents efficiently
      - moonshot variants can escape local plateaus but need explicit risk budgets
    evidence:
      - user requested hill climbing and fitness-aware moonshot variants
      - docs/architecture/evolutionary-operators.md
    working_assumption: add `hill-climb` and `exploratory-leap` operators that record parent candidate, objective focus, search posture and risk budget before realization
    consequence_if_wrong: the loop may over-exploit local improvements or over-explore broad variants without comparable evidence
    blocking: false
    validation:
      - specs/changes/CHG-002-live-loop-policy/
      - docs/architecture/evolutionary-operators.md
    status: open

rejected_options:
  - id: opensearch_vector_storage_now
    option: add OpenSearch, vector storage or external memory now
    status: revisited_for_bounded_experiment
    reason_rejected:
      - no retrieval scale evidence exists
      - repo-native context and SQLite metadata are sufficient for the first slice
    evidence:
      - user explicit non-goal
      - docs/context-store.md
    revisit_when:
      - workflow/evidence corpus needs semantic retrieval with measured local limits
    revisit_outcome:
      - trigger reached by explicit owner direction on 2026-08-02
      - ADR-0004 authorizes only a local Neo4j Community experiment plus derived SQLite projections
      - OpenSearch, generic vector infrastructure and production memory services remain rejected
  - id: ast_mutation_now
    option: mutate Java AST or workflow source using typed code transformations in the first slice
    reason_rejected:
      - first loop can validate targeted behavior contracts and ordinary Git diff realizations without AST infrastructure
      - AST mutation increases blast radius before the loop is proven
    evidence:
      - user explicit non-goal
    revisit_when:
      - targeted contracts repeatedly fail deterministic validation because code-aware structure is required
  - id: distributed_workers_now
    option: distribute candidate evaluation across workers
    reason_rejected:
      - local sequential evaluation is simpler and auditable
      - throughput bottleneck is not yet measured
    evidence:
      - user explicit non-goal
    revisit_when:
      - benchmark queue time blocks experiment cadence
  - id: automatic_production_deployment_now
    option: automatically deploy promoted candidates
    reason_rejected:
      - promotion and rollback governance are not proven
      - user explicitly deferred production deployment automation
    evidence:
      - user explicit non-goal
    revisit_when:
      - protected promotion target and rollback policy have human approval

architecture:
  application_shape: cli
  language: Java
  framework: picocli
  build_system: Gradle
  style: clean_architecture
  modules:
    - modules/domain
    - modules/deterministic
    - modules/adapters
    - modules/benchmarks
    - modules/cli
  module_naming: layers are named for what they may know; domain has no dependencies, deterministic holds validation, scoring, promotion and ports, and nothing provider-aware or nondeterministic may live there
  integrations:
    model_access: LangChain4j typed service through provider-neutral adapter construction
    git: JGit-first read-only repository access plus native Git linked candidate worktrees through adapter
    checks: deterministic command execution through adapter
    benchmarks: JMH evidence adapter
    messaging: none
    external_services:
      - OpenAI via LangChain4j official adapter proposed for first live provider
      - optional local Neo4j Community projection for GRAPH, VECTOR and HYBRID experiments
  persistence:
    canonical_repository: Git-versioned source, specs, ADRs and knowledge
    experiment_metadata: local .saaa/experiments.sqlite through separate ExperimentMetadataStore and EvolutionaryMemoryStore ports/classes/tables
    experiment_rebuild_source: compact Git-versioned experiments/ledger/*.toon envelopes with generated non-authoritative docs/wiki/experiments.md projection
    retrieval_projection_cache: disposable local .saaa/retrieval.sqlite for embeddings, capsules and retrieval provenance
    graph_projection: rebuildable bounded local Neo4j Community named volume inflated from repository revisions plus policy-selected experiment memory
    graph_scope: one database with repository-partitioned SUBJECT and PROCESS projections linked by explicit evolution contexts
    migrations: adapter-owned schemas; retrieval cache and durable experiment responsibilities remain separate

testing:
  harness: gradle_junit5_assertj_jqwik_jmh
  layers:
    - unit: core records, deterministic mutation validation, scoring policies and provider-neutral LangChain4j proposal mapping
    - component: mutation loop with fake model, Git, check and benchmark ports
    - integration: real Git worktree, SQLite, command-check and JMH adapter semantics
    - contract: future workflow and evidence file contracts
    - benchmark: JMH benchmark evidence used by scoring
  test_first: true
  philosophy: testing_trophy
  first_acceptance_test: modules/deterministic/src/acceptanceTest/java/com/dreamthought/saaa/deterministic/MutationEvaluationLoopAcceptanceTest.java

structured_data:
  control_files:
    format: toon
    reason: repository bootstrap tools read PROJECT_PROFILE.toon, HANDOFF.toon and CUSTOMIZE_THIS_PROJECT.toon
  state_and_contracts:
    format: toon
    allowed:
      - toon
      - s_expression
    default_reason: readable, diff-friendly state, specs and handoff contracts
  rules_and_compute:
    format: s_expression
    allowed:
      - toon
      - s_expression
      - none
    default_reason: compact deterministic mutation/operator IR, fitness gates and policy predicates
  mixed_use_allowed: true
  rule: use one semantic format per artifact and record deliberate deviations

containers:
  application_image: not_applicable
  reason: initial project is a local experimental CLI, not a deployable service or web application
  image_test: not_applicable
  compose: one explicit on-demand neo4j_community_service
  compose_image: neo4j:5.26.28-community-ubi10@sha256:56cdf7d9cf639e9b6bdacd9222758457076de08afbc66f79d0965cb56e1cdc5b
  compose_lifecycle: explicit_start_and_shutdown_with_named_rebuildable_volume
  ordinary_tests_require_compose: false

infrastructure:
  local_topology: nix_gradle_local_git_sqlite_plus_optional_neo4j_projection
  development_environment: flake_dev_shell_includes_java_gradle_docker_client_and_compose; nix_run_exposes_the_saaa_java_binary; JGit_requires_no_manual_setup; host_docker_daemon_required_for_neo4j; devenv_not_required
  command_namespace: installed_binary_saaa_with_saaa_prefixed_public_command_tokens
  deployment_target: local_cli
  iac:
    status: not_applicable
    tool: null
    validation_command: null
    revisit_trigger: remote execution or production deployment target selected

tooling:
  superpowers:
    status: optional
  mcp:
    required: []
    optional: []
  context_budget:
    default_target: small
    reserve_response_percent: 30
    packet_style: semantic_summary_with_source_refs
    source_refs_required: true
    opaque_transport_blobs: false
