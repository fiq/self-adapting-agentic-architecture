project:
  state: actor_review_fallback_policy_in_progress
  name: self-adapting-agentic-architecture
  confidence: medium
  concept_date: 2026-07-25
  concept_date_reason: user requested project initialization as a Java-first experimental platform

audience:
  skill_level: developer
  app_shape: cli
  language_by_role:
    - role: core_domain
      language: Java
    - role: cli
      language: Java with picocli
    - role: model_adapter
      language: Java with LangChain4j behind application ports
    - role: persistence
      language: Java with SQLite adapter
    - role: benchmarks
      language: Java with JMH
  right_sizing:
    smallest_sufficient: local Gradle Java CLI evaluating one Git-worktree candidate at a time through plain Java ports and deterministic policies
    deliberately_excluded:
      - OpenSearch and vector storage because the first slice has no large retrieval corpus or semantic search evidence
      - AST mutation because bounded workflow mutations can start as validated workflow-definition patches
      - LSP integration because repair diagnostics can start from deterministic validation output
      - distributed workers because local sequential evaluation is sufficient until benchmark throughput becomes a measured bottleneck
      - automatic production deployment because promotion policy and rollback must be proven manually first
    revisit_when:
      - experiment evidence requires semantic search across workflow or evaluation history
      - text or structured workflow mutations cause repeated safety or correctness failures
      - repairs repeatedly need language-server diagnostics
      - local benchmark throughput blocks research cadence
      - users request unattended promotion into protected integration branches or production
    bought_in: true

facts:
  - id: user_requested_java_platform
    observation: user requested Java, Gradle, LangChain4j, picocli, SQLite, JUnit 5, AssertJ, jqwik, JMH and Git worktrees
    evidence:
      - CUSTOMIZE_THIS_PROJECT.toon
      - user prompt 2026-07-25
    confidence: high
  - id: no_prior_application_runtime
    observation: repository inspection before customization found no application runtime evidence
    evidence:
      - .agentic-template/bin/project init output
      - .agentic-template/bin/inspect-project
    confidence: high

inferences:
  - id: cli_first_experimental_shape
    conclusion: the smallest useful product shape is a local CLI rather than a service
    based_on:
      - user requested picocli
      - candidate isolation depends on local Git worktrees
      - automatic production deployment is explicitly deferred
    confidence: high
    validation: first CLI slice exercises one mutation evaluation end to end
  - id: plain_java_core_boundary
    conclusion: core domain should contain only records, deterministic value checks and policies with no LangChain4j or infrastructure imports
    based_on:
      - user required LangChain4j behind adapters
      - deterministic approval boundary is central to safety
    confidence: high
    validation: .agentic-template/bin/project lint

decisions:
  - id: langchain4j_adapter_boundary
    decision: LangChain4j is allowed only under adapters/langchain4j and through application ports
    reason:
      - keeps the core domain plain Java
      - prevents model-provider details from controlling validation, scoring or promotion
    confidence: high
    status: active
    validation:
      - .agentic-template/bin/project lint
      - docs/architecture/module-boundaries.md
    consequence_if_changed: model-provider code could leak into deterministic decision paths
  - id: deterministic_approval_boundary
    decision: model output may propose or repair mutations but may not approve candidates
    reason:
      - approval must be auditable and repeatable
      - fitness scores and promotion decisions must remain deterministic
    confidence: high
    status: active
    validation:
      - specs/capabilities/CAP-001-mutation-fitness-loop.toon
      - application/src/acceptanceTest/java/io/github/selfadaptingagenticarchitecture/application/MutationEvaluationLoopAcceptanceTest.java
    consequence_if_changed: experiments could self-reinforce model-preferred candidates without independent fitness evidence
  - id: sqlite_experiment_metadata
    decision: persist experiment metadata in SQLite through an adapter
    reason:
      - local experiments need durable audit state
      - SQLite keeps operational complexity low
      - no server database evidence exists yet
    confidence: medium
    status: active
    validation:
      - .agentic-template/bin/project integration-test
    consequence_if_changed: experiment lineage may need a heavier operational dependency
  - id: git_worktree_candidate_isolation
    decision: create mutation candidates in isolated Git worktrees and commit candidate state before evaluation
    reason:
      - isolates candidate changes from coordination checkout
      - gives every evaluation auditable Git provenance
    confidence: high
    status: active
    validation:
      - .agentic-template/bin/project integration-test
    consequence_if_changed: candidate evaluation could mutate shared working state
  - id: no_application_container_initially
    decision: do not build a container image for the first local CLI slice
    reason:
      - there is no deployable service or web app
      - Nix and Gradle are sufficient for local execution
    confidence: medium
    status: active
    validation:
      - README.md
      - .agentic-template/bin/project ready
    consequence_if_changed: distribution work could distract from validating the mutation loop
  - id: jqwik_1_9_3_pending_policy_review
    decision: pin jqwik to 1.9.3 for the initial scaffold
    reason:
      - user requested jqwik property tests
      - jqwik 1.10.x release notes include explicit anti-AI-agent usage language
      - this repository is AI-agent-assisted
    confidence: medium
    status: active
    validation:
      - gradle/libs.versions.toml
      - future dependency policy review
    consequence_if_changed: using jqwik 1.10.x may conflict with the project's AI-assisted workflow
  - id: tool_unavailable_integration_fallback
    decision: allow PR-less actor-reviewed integration only when PR tooling is unavailable and the user explicitly authorizes shipping to main
    reason:
      - GitHub app and gh PR creation were unavailable for this repository
      - direct main integration still needs branch isolation, deterministic checks, completed risk-appropriate actor review when available, lead self-review and explicit provenance
    confidence: high
    status: active
    validation:
      - AGENTS.md
      - docs/wiki/development.md
      - .agents/knowledge/patterns/PAT-001-tool-unavailable-integration-fallback.md
    consequence_if_changed: future agents may either block unnecessarily on unavailable PR tooling or push to main without adequate actor-review evidence

unknowns:
  - id: Q-001
    question: Which model provider and LangChain4j integration should be used first?
    why_it_matters:
      - affects adapter configuration and test doubles
      - affects retrieval and tool-calling support
    evidence:
      - user specified LangChain4j but not a provider
    working_assumption: use provider-neutral LangChain4j `ChatModel` wiring first and choose provider-specific configuration later
    consequence_if_wrong: live adapter configuration may need a provider-specific module or factory later
    blocking: false
    validation:
      - adapters/langchain4j/src/test/java/io/github/selfadaptingagenticarchitecture/adapters/langchain4j/LangChain4jMutationProposalAdapterTest.java
      - choose provider before live model-backed CLI execution
    status: open
  - id: Q-002
    question: What is the first real workflow representation and mutation patch format?
    why_it_matters:
      - determines validation semantics
      - determines whether text patches are enough before AST mutation
    evidence:
      - user requested plain Java records for WorkflowGraph and Mutation
    working_assumption: start with bounded text patch metadata plus deterministic length and authority checks before selecting a richer workflow patch format
    consequence_if_wrong: candidate mutations may be too vague to validate deterministically
    blocking: false
    validation:
      - approve or revise CAP-001 before implementation
    status: open
  - id: Q-003
    question: What branch or namespace should promoted candidates target?
    why_it_matters:
      - promotion can mean a local branch, a candidate registry update or a protected integration branch
      - rollback semantics depend on the target
    evidence:
      - user requested promoted or discarded but did not specify target branch policy
    working_assumption: promote to a local reviewed candidate branch, not main or production
    consequence_if_wrong: automation could affect protected history or integration flow
    blocking: false
    validation:
      - decide promotion target before Git adapter implementation
    status: open
  - id: Q-004
    question: What initial objectives and weights should define multi-objective fitness?
    why_it_matters:
      - score thresholds determine promotion and discard behavior
      - benchmark evidence can dominate correctness if weights are wrong
    evidence:
      - user requested deterministic checks, benchmarks and multi-objective scoring
    working_assumption: start with correctness as gate and benchmark change as weighted evidence
    consequence_if_wrong: candidates may be promoted for speed while failing behavioral intent
    blocking: false
    validation:
      - encode policy in the first implementation spec after approval
    status: open

rejected_options:
  - id: opensearch_vector_storage_now
    option: add OpenSearch, vector storage or external memory now
    reason_rejected:
      - no retrieval scale evidence exists
      - repo-native context and SQLite metadata are sufficient for the first slice
    evidence:
      - user explicit non-goal
      - docs/context-store.md
    revisit_when:
      - workflow/evidence corpus needs semantic retrieval with measured local limits
  - id: ast_mutation_now
    option: mutate Java AST or workflow source using typed code transformations in the first slice
    reason_rejected:
      - first loop can validate bounded workflow-definition mutations without AST infrastructure
      - AST mutation increases blast radius before the loop is proven
    evidence:
      - user explicit non-goal
    revisit_when:
      - text or structured workflow patches repeatedly fail deterministic validation
  - id: distributed_workers_now
    option: distribute candidate evaluation across workers
    reason_rejected:
      - local sequential evaluation is simpler and auditable
      - throughput bottleneck is not yet measured
    evidence:
      - user explicit non-goal
    revisit_when:
      - benchmark queue time blocks experiment cadence
  - id: automatic_production_deployment_now
    option: automatically deploy promoted candidates
    reason_rejected:
      - promotion and rollback governance are not proven
      - user explicitly deferred production deployment automation
    evidence:
      - user explicit non-goal
    revisit_when:
      - protected promotion target and rollback policy have human approval

architecture:
  application_shape: cli
  language: Java
  framework: picocli
  build_system: Gradle
  style: clean_architecture
  modules:
    - core
    - application
    - adapters/langchain4j
    - adapters/git
    - adapters/sqlite
    - adapters/checks
    - benchmarks
    - cli
  integrations:
    model_access: LangChain4j typed service through provider-neutral adapter construction
    git: local Git worktrees through adapter
    checks: deterministic command execution through adapter
    benchmarks: JMH evidence adapter
    messaging: none
    external_services:
      - model provider selected later
  persistence:
    kind: relational
    engine: sqlite
    provider: local_file
    migrations: initial_schema_migration_in_adapter

testing:
  harness: gradle_junit5_assertj_jqwik_jmh
  layers:
    - unit: core records, deterministic mutation validation, scoring policies and provider-neutral LangChain4j proposal mapping
    - component: mutation loop with fake model, Git, check and benchmark ports
    - integration: real Git worktree, SQLite, command-check and JMH adapter semantics
    - contract: future workflow and evidence file contracts
    - benchmark: JMH benchmark evidence used by scoring
  test_first: true
  philosophy: testing_trophy
  first_acceptance_test: application/src/acceptanceTest/java/io/github/selfadaptingagenticarchitecture/application/MutationEvaluationLoopAcceptanceTest.java

structured_data:
  control_files:
    format: toon
    reason: repository bootstrap tools read PROJECT_PROFILE.toon, HANDOFF.toon and CUSTOMIZE_THIS_PROJECT.toon
  state_and_contracts:
    format: toon
    allowed:
      - toon
      - s_expression
    default_reason: readable, diff-friendly state, specs and handoff contracts
  rules_and_compute:
    format: s_expression
    allowed:
      - toon
      - s_expression
      - none
    default_reason: compact deterministic policy predicates if scoring rules need a DSL later
  mixed_use_allowed: true
  rule: use one semantic format per artifact and record deliberate deviations

containers:
  application_image: not_applicable
  reason: initial project is a local experimental CLI, not a deployable service or web application
  image_test: not_applicable
  compose: empty_no_services

infrastructure:
  local_topology: nix_gradle_local_git_sqlite
  deployment_target: local_cli
  iac:
    status: not_applicable
    tool: null
    validation_command: null
    revisit_trigger: remote execution or production deployment target selected

tooling:
  superpowers:
    status: optional
  mcp:
    required: []
    optional: []
  context_budget:
    default_target: small
    reserve_response_percent: 30
    packet_style: semantic_summary_with_source_refs
    source_refs_required: true
    opaque_transport_blobs: false
